{
  "name": "tectonics",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build:wasm": "wasm-pack build sim-rs --target web --release --out-dir ../src/sim-wasm/pkg",
    "build:wasm:threads": "sh scripts/build-wasm-threads.sh",
    "dev": "npm run build:wasm && npm run build:wasm:threads && vite",
    "build": "npm run build:wasm && npm run build:wasm:threads && tsc && vite build",
    "bench": "node --max-old-space-size=8192 --import tsx scripts/bench.ts",
    "bench:compare": "node --import tsx scripts/compare.ts",
    "test:rs": "cargo test --manifest-path sim-rs/Cargo.toml --release",
    "preview": "vite preview",
    "format": "biome format --write .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "simplex-noise": "^4.0.3",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.0",
    "@types/three": "^0.169.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
